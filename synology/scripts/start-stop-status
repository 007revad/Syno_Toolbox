#!/bin/sh
#----------------------------------------------------------
# CPUTemp has no background daemon - it runs on demand when
# the main window is opened. Standard no-daemon template.
#----------------------------------------------------------

case "$1" in
    start)
        exit 0
        ;;
    stop)
        exit 0
        ;;
    status)
        exit 0
        ;;
    log)
        exit 0
        ;;
    *)
        exit 1
        ;;
esac
