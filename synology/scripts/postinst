#!/bin/bash

PKG_NAME=$(basename "$SYNOPKG_PKGDEST")
TARGET_DIR="/var/packages/$PKG_NAME/target"
UI_DIR="$TARGET_DIR/ui"
BIN_DIR="$TARGET_DIR/bin"
MODULES_DIR="$BIN_DIR/modules"
SBIN_DIR="$TARGET_DIR/sbin"

# Get DSM major version
dsm=$(/usr/syno/bin/synogetkeyvalue /etc.defaults/VERSION majorversion)
if [[ $dsm -ge 7 ]]; then
    VAR_DIR="/var/packages/${PKG_NAME}/var"
else
    VAR_DIR="/var/packages/${PKG_NAME}/etc"
fi

# Log function
log_message() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$VAR_DIR/install.log" 2>/dev/null || echo "$1"
}

echo "" >> "$VAR_DIR/install.log"
log_message "Post-installation starting for package: $PKG_NAME"
log_message "Running postinst as: $(whoami) (uid=$(id -u))"

# Remove spurious files injected by the package builder
rm -f "$UI_DIR/Makefile"
rm -f "$UI_DIR/ui"  # self-referencing symlink
rm -f "$UI_DIR/texts/strings"  # strings file template
log_message "Removed spurious package builder files"

if [[ $dsm -le 6 ]]; then
    rm -f "$TARGET_DIR/bin/helper/synotoolbox-helper"
    log_message "Removed helper/synotoolbox-helper (only needed for DSM 7)"   
fi

# Set execute permissions
chmod +x "$UI_DIR/api.cgi" 2>/dev/null
log_message "Set execute permissions for api.cgi"

for binfile in "$BIN_DIR"/*.sh "$BIN_DIR"/*.py; do
    chmod +x "$BIN_DIR/$binfile" 2>/dev/null
    chmod 555 "$BIN_DIR/$binfile" 2>/dev/null              # Blocks injection exploit
    log_message "Set execute permissions for $binfile"
done

for module in "$MODULES_DIR/"*.sh "$MODULES_DIR/"*.py; do
    chmod +x "$module" 2>/dev/null
    chmod 555 "$module" 2>/dev/null                        # Blocks injection exploit
    log_message "Set execute permissions for $module"
done

# Set owner:group on logs to package:package
if [[ -d "$VAR_DIR" ]]; then
    chown -R "${PKG_NAME}:$PKG_NAME" "${VAR_DIR}/"
fi

# NOTE: sudoers grant is NOT created here. postinst is not reliably
# running as root on DSM 7 (see set_package_permissions.md), so the
# NOPASSWD grant that lets api.cgi write the live feeds file as root has
# to be setup manually (SSH or Task Scheduler), same as my other packages.

# Lock down synotoolbox_api.sh
chmod 555 "$BIN_DIR/synotoolbox_api.sh" 2>/dev/null        # Blocks injection exploit
log_message "Secured synotoolbox_api.sh"


# Lock down bin and sbin and modules folders
# Must be after "chmod 555" and "chmod +x" for files in these folders
chmod 555 "$MODULES_DIR" 2>/dev/null                       # Blocks delete/recreate/rename exploit
chmod 555 "$BIN_DIR" 2>/dev/null                           # Blocks delete/recreate/rename exploit
chmod 555 "${SBIN_DIR:?}" 2>/dev/null                      # Blocks delete/recreate/rename exploit
log_message "Secured bin, sbin and modules folders"

# Lock down target folder
# Must be the last command
chmod 555 "/var/packages/${PKG_NAME}/target" 2>/dev/null   # Blocks delete/recreate/rename exploit


if [ -z "$ERRORS" ]; then
    log_message "Post-installation completed successfully"
else
    log_message "Post-installation completed with warnings"
fi
echo >> "$VAR_DIR/install.log"
exit 0
