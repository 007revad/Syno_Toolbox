{
  "modules": [
    {
      "id": "fix_size_units",
      "name": "Fix Size Units",
      "control": "toggle-display",
      "script": "modules/fix_size_units.sh",
      "trigger": "boot",
      "live": false,
      "run_args": [],
      "disable_args": null
    },
    {
      "id": "telnet_password",
      "name": "DSM Telnet Password",
      "control": "toggle-display",
      "script": "modules/dsm_telnet_password.sh",
      "trigger": "boot",
      "live": false,
      "run_args": [],
      "disable_args": null
    },
    {
      "id": "cleanup_coredumps",
      "name": "Cleanup Coredumps",
      "control": "toggle-display",
      "script": "modules/cleanup_coredumps.sh",
      "trigger": "boot",
      "live": false,
      "run_args": [],
      "disable_args": null
    },
    {
      "id": "toggle_reset_button",
      "name": "Toggle Reset Button",
      "control": "toggle-display",
      "script": "modules/toggle_reset_button.sh",
      "trigger": "boot",
      "live": false,
      "run_args": ["enable"],
      "disable_args": ["disable"],
      "check_args": ["check"],
      "note": "single script, 3 modes (enable/disable/check) verified by Dave - not separate files"
    },
    {
      "id": "low_current_spinup",
      "name": "Seagate Low Current Spinup",
      "control": "toggle-display",
      "script": "modules/seagate_low_current_spinup.sh",
      "trigger": "boot",
      "live": false,
      "run_args": [],
      "disable_args": null
    },
    {
      "id": "created_date",
      "name": "Synology Created Date",
      "control": "toggle-display",
      "script": "modules/synology_created_date.sh",
      "trigger": "boot",
      "live": true,
      "run_args": [],
      "disable_args": null,
      "note": "candidate for header display instead of a toggle row"
    },
    {
      "id": "restore_fan_speed",
      "name": "Restore RS3621 Fan Speed",
      "control": "toggle-display",
      "script": "modules/restore_rs3621_fan_speed.sh",
      "trigger": "boot",
      "live": false,
      "run_args": [],
      "disable_args": null
    },
    {
      "id": "uninstall_active_insight",
      "name": "Uninstall Active Insight",
      "control": "toggle-run",
      "script": "modules/uninstall_active_insight.sh",
      "trigger": "boot",
      "live": false,
      "run_args": [],
      "disable_args": null,
      "note": "run_args wraps: sudo /usr/syno/bin/synopkg uninstall ActiveInsight - confirm exact wrapper script contents before shipping"
    },
    {
      "id": "ups_connected",
      "name": "Check UPS Connected",
      "control": "toggle-schedule",
      "script": "modules/check_ups_connected.sh",
      "trigger": "scheduled",
      "live": false,
      "run_args": [],
      "disable_args": null,
      "schedule": { "default_repeat_hour": 6 }
    },
    {
      "id": "config_backup",
      "name": "Synology Config Backup",
      "control": "toggle-config-backup",
      "script": "modules/synology_config_backup.sh",
      "trigger": "scheduled",
      "live": false,
      "run_args": [],
      "disable_args": null,
      "schedule": { "default_repeat_hour": 24 },
      "note": "Script reads its own settings straight from toolbox.conf (config_backup_* keys) rather than taking CLI args - run_args stays empty. Conf keys mirror the script's own variable names: target_dir, remote_backup, remote_port, remote_ip, remote_dir, local_user, remote_user, and the same set prefixed remote2_/local2_ for the 2nd optional remote. Discover NAS is repurposed here to prefill Remote IP fields, not as a source-NAS list."
    },
    {
      "id": "synoboot_backup",
      "name": "Synoboot Backup",
      "control": "toggle-filepicker",
      "script": "modules/synoboot_backup.sh",
      "trigger": "scheduled",
      "live": false,
      "run_args": [],
      "disable_args": null,
      "filepicker": { "label": "Backup destination path" }
    },
    {
      "id": "seq_io",
      "name": "Sequential I/O Tuning",
      "control": "toggle-volume-numeric",
      "script": "modules/syno_seq_io.sh",
      "trigger": "boot",
      "live": false,
      "run_args": ["--volumes={volumes}", "--kb={kb}"],
      "disable_args": ["--volumes={volumes}", "--kb=1024"],
      "numeric": { "label": "Sequential I/O (kb)", "default": 1024, "min": 4 },
      "volume_source": "listvolumes",
      "note": "Confirmed CLI: --volumes=VOLUME[,VOLUME...] --kb=KB. Disable re-runs with --kb=1024 against the same selected volumes."
    },
    {
      "id": "shr_switch",
      "name": "SHR / RAID Group Switch",
      "control": "toggle-selector",
      "script": "modules/synology_shr_switch.sh",
      "trigger": "on_save",
      "live": false,
      "run_args": ["{mode}", "{raidf1}"],
      "disable_args": null,
      "selector": {
        "options": [
          { "label": "SHR", "value": "shr" },
          { "label": "RAID Group", "value": "raidgrp" }
        ],
        "secondary_toggle": { "label": "RAID F1", "value": "raidf1" }
      },
      "note": "Confirmed positional CLI: synology_shr_switch.sh <shr|raidgrp> [raidf1]. raidf1 is an optional 2nd positional arg. Our placeholder substitution always passes 2 args - when RAID F1 isn't checked, {raidf1} resolves to an empty string rather than being omitted entirely. ASSUMPTION (not confirmed by Dave): the script treats an empty/non-matching 2nd arg the same as a missing one. Verify against the actual script before relying on this."
    }
  ]
}
